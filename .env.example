# ------------------------------------------------------------------
# MUNCHIVO MANAGEMENT — environment variables
#
# NEVER put real secrets in this file or in .env / .env.local.
# Copy this file to .env.local and replace the values locally, or set
# them in the Vercel project dashboard for production.
# ------------------------------------------------------------------

# Neon PostgreSQL connection string (from your Neon dashboard).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Web Push (optional but recommended) --------------------------
# Generate a fresh pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@munchivo.com"

# --- Daily alert cron (production) --------------------------------
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`.
# Leave empty for local development.
CRON_SECRET=""
